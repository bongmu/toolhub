---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import FavoriteButton from '../components/FavoriteButton';
import RecentTracker from '../components/RecentTracker';
import { getCategory, toolsByCategory, SITE, type Tool } from '../data/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const category = getCategory(tool.category);
const related = toolsByCategory(tool.category).filter((t) => t.slug !== tool.slug);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const title = `${tool.name} - 在线免费工具 | ${SITE.name}`;
const description = `${tool.description}。免费在线使用，无需注册下载，数据本地处理不上传服务器。`;

// 结构化数据：WebApplication + 面包屑 + FAQ，帮助搜索引擎理解页面
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.name,
    url: canonicalURL.href,
    description: tool.description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).href },
      ...(category
        ? [
            {
              '@type': 'ListItem',
              position: 2,
              name: category.name,
              item: new URL(`/#cat-${category.id}`, Astro.site).href,
            },
          ]
        : []),
      {
        '@type': 'ListItem',
        position: category ? 3 : 2,
        name: tool.name,
        item: canonicalURL.href,
      },
    ],
  },
];

if (tool.faqs?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: tool.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <RecentTracker client:load slug={tool.slug} />
  <!-- 文本处理类工具需要大编辑区，放宽到 max-w-7xl -->
  <div class:list={['mx-auto px-4 py-8', tool.bigInput ? 'max-w-7xl' : 'max-w-4xl']}>
    <!-- 面包屑 -->
    <nav class="mb-4 text-sm text-gray-400 dark:text-gray-500">
      <a href="/" class="transition hover:text-indigo-600 dark:hover:text-indigo-400">首页</a>
      {
        category && (
          <>
            <span class="mx-1.5">/</span>
            <a
              href={`/#cat-${category.id}`}
              class="transition hover:text-indigo-600 dark:hover:text-indigo-400"
            >
              {category.icon} {category.name}
            </a>
          </>
        )
      }
      <span class="mx-1.5">/</span>
      <span class="text-gray-600 dark:text-gray-300">{tool.name}</span>
    </nav>

    <!-- 标题区 -->
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-3xl">{tool.icon}</span>
      <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-gray-50">{tool.name}</h1>
      <FavoriteButton client:load slug={tool.slug} />
    </div>
    <p class="mt-2 text-gray-500 dark:text-gray-400">{tool.description}</p>

    <!-- 广告位：标题下方（接入 AdSense 后显示） -->
    <AdSlot />

    <!-- 工具本体（id 供"放大"功能定位；全屏时由脚本加 fixed 覆盖整个视口） -->
    <div
      id="tool-card"
      class="mt-6 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-[padding] sm:p-6 dark:border-gray-800 dark:bg-gray-900"
    >
      <slot />
    </div>

    <script is:inline>
      // 监听工具组件发出的放大/还原事件
      window.addEventListener('tool-expand', (e) => {
        const card = document.getElementById('tool-card');
        if (!card) return;
        const on = e.detail;
        card.classList.toggle('fixed', on);
        card.classList.toggle('inset-0', on);
        card.classList.toggle('z-50', on);
        card.classList.toggle('overflow-auto', on);
        card.classList.toggle('rounded-none', on);
        document.body.style.overflow = on ? 'hidden' : '';
      });
    </script>

    <!-- 相关工具（同类其他工具，提升站内跳转） -->
    {
      related.length > 0 && (
        <section class="mt-10">
          <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100">相关工具</h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {related.map((t) => (
              <a
                href={`/tools/${t.slug}/`}
                class="group flex items-center gap-3 rounded-xl border border-gray-200 bg-white px-4 py-3 transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md dark:border-gray-800 dark:bg-gray-900 dark:hover:border-indigo-700"
              >
                <span class="text-2xl">{t.icon}</span>
                <div class="min-w-0">
                  <div class="truncate font-medium text-gray-900 group-hover:text-indigo-600 dark:text-gray-100 dark:group-hover:text-indigo-400">
                    {t.name}
                  </div>
                  <div class="truncate text-sm text-gray-500 dark:text-gray-400">{t.description}</div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- SEO 介绍文案 -->
    {
      tool.seoContent?.length ? (
        <section class="mt-10 max-w-none">
          <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">关于{tool.name}</h2>
          {tool.seoContent.map((p) => (
            <p class="mt-3 leading-relaxed text-gray-600 dark:text-gray-400">{p}</p>
          ))}
        </section>
      ) : null
    }

    <!-- 常见问题 -->
    {
      tool.faqs?.length ? (
        <section class="mt-10">
          <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">常见问题</h2>
          <div class="mt-4 space-y-3">
            {tool.faqs.map((f) => (
              <details class="group rounded-xl border border-gray-200 bg-white px-5 py-4 dark:border-gray-800 dark:bg-gray-900">
                <summary class="flex cursor-pointer list-none items-center justify-between font-medium text-gray-800 dark:text-gray-200">
                  {f.q}
                  <span class="ml-2 text-gray-400 transition group-open:rotate-180">▾</span>
                </summary>
                <p class="mt-3 leading-relaxed text-gray-600 dark:text-gray-400">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      ) : null
    }

    <!-- 广告位：页面底部 -->
    <AdSlot />
  </div>
</BaseLayout>
