---
import { CATEGORIES, SITE } from '../data/tools';
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/80 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4">
    <a href="/" class="flex items-center gap-2 text-lg font-bold text-gray-900">
      <span class="text-2xl">🧰</span>
      <span>{SITE.name}</span>
    </a>
    <nav class="hidden items-center gap-1 sm:flex">
      {
        CATEGORIES.map((c) => (
          <a
            href={`/#cat-${c.id}`}
            class="rounded-lg px-3 py-1.5 text-sm text-gray-600 transition hover:bg-gray-100 hover:text-gray-900"
          >
            {c.icon} {c.name}
          </a>
        ))
      }
    </nav>
    <a
      href="/"
      class="rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-indigo-700 sm:hidden"
    >
      全部工具
    </a>
  </div>
</header>
