---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOLS } from '../data/tools';
---

<BaseLayout title="页面不存在 | ToolHub 工具箱" description="你要找的页面不存在">
  <div class="mx-auto max-w-2xl px-4 py-20 text-center">
    <div class="text-7xl">🔍</div>
    <h1 class="mt-6 text-3xl font-bold text-gray-900">页面不存在</h1>
    <p class="mt-3 text-gray-500">你要找的页面可能已被移动或删除，不如看看这些热门工具：</p>
    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        TOOLS.slice(0, 6).map((t) => (
          <a
            href={`/tools/${t.slug}/`}
            class="rounded-xl border border-gray-200 bg-white p-4 text-left transition hover:border-indigo-300 hover:shadow-sm"
          >
            <div class="font-medium text-gray-900">{t.name}</div>
            <div class="mt-1 line-clamp-1 text-sm text-gray-500">{t.description}</div>
          </a>
        ))
      }
    </div>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-indigo-600 px-6 py-2.5 font-medium text-white transition hover:bg-indigo-700"
    >
      返回首页
    </a>
  </div>
</BaseLayout>
